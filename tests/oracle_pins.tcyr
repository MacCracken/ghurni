test_group("motor properties (rust-old/src/motor.rs:61-64, 153-156)");
assert_eq(ghurni_motor_noise_cutoff(GH_MOTOR_DC_BRUSHED), f64_from(4000), "DcBrushed cutoff 4000");
assert_eq(ghurni_motor_noise_cutoff(GH_MOTOR_AC_INDUCTION), f64_from(2000), "AcInduction cutoff 2000");
assert_eq(ghurni_motor_noise_cutoff(GH_MOTOR_BRUSHLESS), f64_from(6000), "Brushless cutoff 6000");
assert_eq(ghurni_motor_noise_cutoff(GH_MOTOR_SERVO), f64_from(3000), "Servo cutoff 3000");
assert_eq(ghurni_motor_noise_level(GH_MOTOR_DC_BRUSHED), 0.15, "DcBrushed noise 0.15");
assert_eq(ghurni_motor_noise_level(GH_MOTOR_AC_INDUCTION), 0.05, "AcInduction noise 0.05");
assert_eq(ghurni_motor_noise_level(GH_MOTOR_BRUSHLESS), 0.02, "Brushless noise 0.02");
assert_eq(ghurni_motor_noise_level(GH_MOTOR_SERVO), 0.08, "Servo noise 0.08");
# em_frequency = (rpm/60) * poles. 8 poles @ 1500 rpm = 200 Hz exactly.
var mo = ghurni_motor_new(GH_MOTOR_BRUSHLESS, 8, SR);
assert_eq(ghurni_motor_em_frequency(mo, f64_from(1500)), f64_from(200), "8 poles @1500 rpm = 200 Hz");
assert_eq(ghurni_motor_em_frequency(mo, 0), 0, "0 rpm = 0 Hz");

