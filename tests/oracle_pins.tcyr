# ================================================================
test_group("engine resonances + firing order (rust-old/src/engine.rs:89-101)");
# exhaust: Gasoline 150+cyl*20, Diesel 80+cyl*15, TwoStroke 200+cyl*30, Hybrid 300
# intake:  Gasoline 400+cyl*30, Diesel 250+cyl*20, TwoStroke 500+cyl*40, Hybrid 600
var e_gas = ghurni_engine_new(GH_ENGINE_GASOLINE, 8, SR);
assert_eq(GhEngine_exhaust_resonance(e_gas), f64_from(310), "Gasoline 8cyl exhaust = 150+160");
assert_eq(GhEngine_intake_resonance(e_gas), f64_from(640), "Gasoline 8cyl intake = 400+240");
var e_dsl = ghurni_engine_new(GH_ENGINE_DIESEL, 6, SR);
assert_eq(GhEngine_exhaust_resonance(e_dsl), f64_from(170), "Diesel 6cyl exhaust = 80+90");
assert_eq(GhEngine_intake_resonance(e_dsl), f64_from(370), "Diesel 6cyl intake = 250+120");
var e_2s = ghurni_engine_new(GH_ENGINE_TWO_STROKE, 1, SR);
assert_eq(GhEngine_exhaust_resonance(e_2s), f64_from(230), "TwoStroke 1cyl exhaust = 200+30");
assert_eq(GhEngine_intake_resonance(e_2s), f64_from(540), "TwoStroke 1cyl intake = 500+40");
var e_hyb = ghurni_engine_new(GH_ENGINE_HYBRID, 4, SR);
assert_eq(GhEngine_exhaust_resonance(e_hyb), f64_from(300), "Hybrid exhaust 300 (cylinder-independent)");
assert_eq(GhEngine_intake_resonance(e_hyb), f64_from(600), "Hybrid intake 600 (cylinder-independent)");
# cylinders.clamp(1, 16)
assert_eq(GhEngine_cylinders(ghurni_engine_new(GH_ENGINE_GASOLINE, 0, SR)), 1, "cylinders clamp up to 1");
assert_eq(GhEngine_cylinders(ghurni_engine_new(GH_ENGINE_GASOLINE, 99, SR)), 16, "cylinders clamp down to 16");
# Even firing: 4-stroke cycle 720 deg, offsets[i] = i * 720/cyl.
var off4 = GhEngine_firing_offsets(ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR));
assert_eq(vec_len(off4), 4, "4 cylinders -> 4 offsets");
assert_eq(vec_get(off4, 0), 0, "offset[0] = 0");
assert_eq(vec_get(off4, 1), f64_from(180), "offset[1] = 180 (720/4)");
assert_eq(vec_get(off4, 2), f64_from(360), "offset[2] = 360");
assert_eq(vec_get(off4, 3), f64_from(540), "offset[3] = 540");
# 2-stroke cycle is 360 deg, so the same 4 cylinders space at 90.
var off2 = GhEngine_firing_offsets(ghurni_engine_new(GH_ENGINE_TWO_STROKE, 4, SR));
assert_eq(vec_get(off2, 1), f64_from(90), "two-stroke offset[1] = 90 (360/4)");
assert_eq(vec_get(off2, 3), f64_from(270), "two-stroke offset[3] = 270");
# firing_frequency: 4-stroke fires cylinders*rpm/120; 4cyl @3000 = 100 Hz exactly.
var e4 = ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR);
assert_eq(ghurni_engine_firing_frequency(e4, f64_from(3000)), f64_from(100), "4cyl 4-stroke @3000 = 100 Hz");

# ================================================================
test_group("engine event durations (rust-old/src/engine.rs:188-204, 318)");
# backfire = sample_rate * 0.1 ; knock = sample_rate * 0.02 ; decel pop = *0.3
var e_ev = ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR);
ghurni_engine_trigger_event(e_ev, ghurni_event_backfire());
assert_eq(GhEngine_backfire_remaining(e_ev), 4410, "backfire = 0.1 s = 4410 samples");
ghurni_engine_trigger_event(e_ev, ghurni_event_knock(2));
assert_eq(vec_get(GhEngine_knock_remaining(e_ev), 2), 882, "knock = 0.02 s = 882 samples");
assert_eq(vec_get(GhEngine_knock_remaining(e_ev), 0), 0, "knock is per-cylinder, not global");
ghurni_engine_trigger_event(e_ev, ghurni_event_misfire(1));
assert_eq(vec_get(GhEngine_misfire_flags(e_ev), 1), 1, "misfire flags the named cylinder");
assert_eq(vec_get(GhEngine_misfire_flags(e_ev), 0), 0, "misfire is per-cylinder");
# Out-of-range cylinder is ignored, not an abort (ports .get_mut()/if let Some).
ghurni_engine_trigger_event(e_ev, ghurni_event_knock(99));
ghurni_engine_trigger_event(e_ev, ghurni_event_misfire(0 - 1));
assert_eq(vec_len(GhEngine_knock_remaining(e_ev)), 4, "out-of-range event cylinder ignored safely");
# Decel pop: prev_load > 0.5, new load < 0.15, rpm > 3000 (engine.rs:318).
var e_dp = ghurni_engine_new(GH_ENGINE_GASOLINE, 8, SR);
ghurni_engine_set_rpm(e_dp, f64_from(4000));
ghurni_engine_set_load(e_dp, 0.8);
assert_eq(GhEngine_decel_pop_remaining(e_dp), 0, "no pop before the load drop");
ghurni_engine_set_load(e_dp, 0.1);
assert_eq(GhEngine_decel_pop_remaining(e_dp), 13230, "decel pop = 0.3 s = 13230 samples");
# The triple must ALL hold: a drop at low rpm must not fire.
var e_lo = ghurni_engine_new(GH_ENGINE_GASOLINE, 8, SR);
ghurni_engine_set_rpm(e_lo, f64_from(1000));
ghurni_engine_set_load(e_lo, 0.8);
ghurni_engine_set_load(e_lo, 0.1);
assert_eq(GhEngine_decel_pop_remaining(e_lo), 0, "no decel pop below 3000 rpm");

# ================================================================
test_group("differential ring/pinion asymmetry (rust-old/src/differential.rs:90-99)");
# ratio() = ring/pinion, but mesh_frequency() uses PINION teeth -- the
# driveshaft turns the pinion. A ring/pinion swap is otherwise silent.
var dif = ghurni_differential_new(41, 11, SR);
assert_eq(GhDifferential_ring_teeth(dif), 41, "ring teeth stored");
assert_eq(GhDifferential_pinion_teeth(dif), 11, "pinion teeth stored");
# 41/11 = 3.727272... ; assert the ordering rather than a repeating decimal.
assert_gt(ghurni_differential_ratio(dif), f64_from(3), "ratio = ring/pinion > 3");
assert_lt(ghurni_differential_ratio(dif), f64_from(4), "ratio = ring/pinion < 4");
# mesh = (rpm/60) * pinion. 6000 rpm, 11 pinion teeth = 1100 Hz EXACTLY.
# With ring (41) it would be 4100 -- so this number alone catches a swap.
assert_eq(ghurni_differential_mesh_frequency(dif, f64_from(6000)), f64_from(1100), "mesh uses PINION: 6000/60*11 = 1100 Hz");
assert_neq(ghurni_differential_mesh_frequency(dif, f64_from(6000)), f64_from(4100), "mesh is NOT ring teeth");
# Clamps: ring 20..80, pinion 4..30.
assert_eq(GhDifferential_ring_teeth(ghurni_differential_new(1, 11, SR)), 20, "ring clamps up to 20");
assert_eq(GhDifferential_ring_teeth(ghurni_differential_new(999, 11, SR)), 80, "ring clamps down to 80");
assert_eq(GhDifferential_pinion_teeth(ghurni_differential_new(41, 1, SR)), 4, "pinion clamps up to 4");
assert_eq(GhDifferential_pinion_teeth(ghurni_differential_new(41, 999, SR)), 30, "pinion clamps down to 30");

# ================================================================
test_group("forced induction: auto-BOV trigger triple (rust-old/src/forced_induction.rs:122)");
# if prev_load > 0.5 && load < 0.2 && spool_rpm.current() > 5000 -> trigger_bov()
# Spool must be SPUN UP first: set_load gates on spool_rpm.current(), which only
# moves once a block has been rendered, so a cold instance can never fire.
var fi = ghurni_forced_induction_new(GH_INDUCTION_TURBO, f64_from(2), 0.1, SR);
ghurni_forced_induction_set_rpm(fi, f64_from(6000));
ghurni_forced_induction_set_load(fi, 0.9);
assert_eq(GhForcedInduction_bov_active(fi), 0, "BOV idle before any render");
var spin = vec_new();
var si = 0;
while (si < 44100) { vec_push(spin, 0); si = si + 1; }
ghurni_forced_induction_process_block(fi, spin);
assert_gt(ghurni_smooth_current(GhForcedInduction_spool_rpm(fi)), f64_from(5000), "spool is above the 5000 gate");
ghurni_forced_induction_set_load(fi, 0.1);
assert_eq(GhForcedInduction_bov_active(fi), 1, "BOV fires on a sharp drop at high spool");
assert_eq(GhForcedInduction_bov_remaining(fi), 6615, "BOV burst = 0.15 s = 6615 samples");
# Each leg of the triple is load-bearing: a SHALLOW drop must not fire.
var fi2 = ghurni_forced_induction_new(GH_INDUCTION_TURBO, f64_from(2), 0.1, SR);
ghurni_forced_induction_set_rpm(fi2, f64_from(6000));
ghurni_forced_induction_set_load(fi2, 0.9);
var spin2 = vec_new();
var s2 = 0;
while (s2 < 44100) { vec_push(spin2, 0); s2 = s2 + 1; }
ghurni_forced_induction_process_block(fi2, spin2);
ghurni_forced_induction_set_load(fi2, 0.3);
assert_eq(GhForcedInduction_bov_active(fi2), 0, "no BOV when the new load is >= 0.2");
# ...and a drop from an already-low load must not fire.
var fi3 = ghurni_forced_induction_new(GH_INDUCTION_TURBO, f64_from(2), 0.1, SR);
ghurni_forced_induction_set_rpm(fi3, f64_from(6000));
ghurni_forced_induction_set_load(fi3, 0.4);
var spin3 = vec_new();
var s3 = 0;
while (s3 < 44100) { vec_push(spin3, 0); s3 = s3 + 1; }
ghurni_forced_induction_process_block(fi3, spin3);
ghurni_forced_induction_set_load(fi3, 0.1);
assert_eq(GhForcedInduction_bov_active(fi3), 0, "no BOV when prev_load <= 0.5");
# ...and the SPOOL gate itself is load-bearing. target_spool = rpm * ratio *
# load, so 1000 rpm x 2.0 x 0.9 = 1800 -- a big load drop from a high prev_load,
# but below the 5000 gate. Without this case, lowering the gate to 500 passes.
var fi4 = ghurni_forced_induction_new(GH_INDUCTION_TURBO, f64_from(2), 0.1, SR);
ghurni_forced_induction_set_rpm(fi4, f64_from(1000));
ghurni_forced_induction_set_load(fi4, 0.9);
var spin4 = vec_new();
var s4 = 0;
while (s4 < 44100) { vec_push(spin4, 0); s4 = s4 + 1; }
ghurni_forced_induction_process_block(fi4, spin4);
var spool4 = ghurni_smooth_current(GhForcedInduction_spool_rpm(fi4));
assert_gt(spool4, f64_from(1000), "fixture spool really did spin up (not a vacuous check)");
assert_lt(spool4, f64_from(5000), "fixture spool sits BELOW the 5000 gate");
ghurni_forced_induction_set_load(fi4, 0.1);
assert_eq(GhForcedInduction_bov_active(fi4), 0, "no BOV below the 5000 spool gate");

# ================================================================
test_group("chain drive: silent below 1 Hz, and the RNG does not advance");
# rust-old/src/chain_drive.rs:98-101 `continue`s below 1 Hz engagement, skipping
# BOTH next_sample() draws -- so a chain's noise sequence is a function of its
# whole RPM history, not just elapsed samples.
var ch = ghurni_chain_drive_new(110, 16, SR);
var quiet = ghurni_chain_drive_synthesize(ch, 0, 0.1);
assert_eq(vec_len(quiet), 4410, "0 rpm still returns a full buffer");
var all_zero = 1;
var qi = 0;
while (qi < vec_len(quiet)) {
    if (vec_get(quiet, qi) != 0) { all_zero = 0; qi = vec_len(quiet); }
    qi = qi + 1;
}
assert_eq(all_zero, 1, "0 rpm is EXACTLY silent, not merely quiet");
# The non-advancing RNG, isolated. Rendering a silent block must draw NO noise,
# so a chain that has idled is at the SAME point in its stream as one that never
# ran. Comparing rendered audio would NOT show this -- sample_position advances
# during the idle either way, which shifts engagement phase and makes the two
# buffers differ for an unrelated reason. Pull from the generators directly.
var ch_a = ghurni_chain_drive_new(110, 16, SR);
var ch_b = ghurni_chain_drive_new(110, 16, SR);
var idle = ghurni_chain_drive_synthesize(ch_a, 0, 0.05);
assert_eq(vec_len(idle), 2205, "idle block rendered");
var na = GhChainDrive_noise_gen(ch_a);
var nb = GhChainDrive_noise_gen(ch_b);
var aligned = 1;
var nonzero = 0;
var di = 0;
while (di < 32) {
    var sa = noise_next_sample(na);
    var sb = noise_next_sample(nb);
    if (sa != sb) { aligned = 0; }
    if (f64_abs(sb) != 0) { nonzero = 1; }
    di = di + 1;
}
assert_eq(nonzero, 1, "reference noise stream is real signal (not a 0 == 0 compare)");
assert_eq(aligned, 1, "2205 silent samples drew NO noise -- generators stay aligned");

# Control: a RUNNING block DOES draw noise, so the same comparison then fails.
var ch_c = ghurni_chain_drive_new(110, 16, SR);
var ch_d = ghurni_chain_drive_new(110, 16, SR);
var ran = ghurni_chain_drive_synthesize(ch_c, f64_from(3000), 0.05);
assert_eq(vec_len(ran), 2205, "running block rendered");
var nc = GhChainDrive_noise_gen(ch_c);
var nd = GhChainDrive_noise_gen(ch_d);
var drifted = 0;
var dj = 0;
while (dj < 32) {
    if (noise_next_sample(nc) != noise_next_sample(nd)) { drifted = 1; }
    dj = dj + 1;
}
assert_eq(drifted, 1, "control: a running block DOES advance the generator");

# ================================================================
test_group("mixer equal-power pan law (rust-old/src/mixer.rs:167-176)");
# left = cos(angle), right = sin(angle), angle = (pan+1)/2 * PI/2.
# pan = -1 -> angle 0    -> left 1.0, right 0.0  (hard left)
# pan = +1 -> angle PI/2 -> left 0.0, right 1.0  (hard right)
# pan =  0 -> angle PI/4 -> both cos(PI/4) = 0.7071 (the -3 dB centre)
var mx = ghurni_mixer_new();
var mg = ghurni_gear_new(32, GH_GEAR_STEEL, SR);
ghurni_mixer_add_channel(mx, "g", GH_KIND_GEAR, mg);
ghurni_mixer_set_rpm(mx, f64_from(1500));
var L = vec_new();
var R = vec_new();
var pi2 = 0;
while (pi2 < 512) { vec_push(L, 0); vec_push(R, 0); pi2 = pi2 + 1; }

fn chan_energy(v) {
    var n = vec_len(v);
    var s = 0;
    var i = 0;
    while (i < n) { var x = vec_get(v, i); s = f64_add(s, f64_mul(x, x)); i = i + 1; }
    return s;
}

ghurni_mixer_set_channel_pan(mx, 0, f64_neg(F64_ONE));
ghurni_mixer_process_block_stereo(mx, L, R);
var eL_left = chan_energy(L);
var eR_left = chan_energy(R);
assert_gt(eL_left, 0, "hard-left: left channel has signal (not a vacuous compare)");
assert_gt(eL_left, eR_left, "pan -1 puts energy in LEFT (cos), not right");
assert_lt(eR_left, f64_mul(eL_left, 0.000001), "pan -1 leaves right effectively silent");

ghurni_mixer_set_channel_pan(mx, 0, F64_ONE);
ghurni_mixer_process_block_stereo(mx, L, R);
var eL_right = chan_energy(L);
var eR_right = chan_energy(R);
assert_gt(eR_right, eL_right, "pan +1 puts energy in RIGHT (sin)");
assert_lt(eL_right, f64_mul(eR_right, 0.000001), "pan +1 leaves left effectively silent");

# Centre: equal power, and each side at cos(PI/4) -- so per-side ENERGY is half
# the hard-panned side's. That is the -3 dB centre convention.
ghurni_mixer_set_channel_pan(mx, 0, 0);
ghurni_mixer_process_block_stereo(mx, L, R);
var eL_mid = chan_energy(L);
var eR_mid = chan_energy(R);
assert_gt(eL_mid, 0, "centre pan: real signal present");
var mid_ratio = f64_div(eL_mid, eR_mid);
assert_gt(mid_ratio, 0.999, "centre pan is equal-power (L/R ratio ~ 1)");
assert_lt(mid_ratio, 1.001, "centre pan is equal-power (L/R ratio ~ 1)");

# ================================================================
test_group("process_block_stereo leaves the longer buffer's tail untouched");
# rust-old/src/mixer.rs:144-150 zeroes only left[..len]/right[..len] and writes
# only 0..len, where len = min(left, right). The tail keeps its prior contents.
var mx2 = ghurni_mixer_new();
ghurni_mixer_add_channel(mx2, "g", GH_KIND_GEAR, ghurni_gear_new(32, GH_GEAR_STEEL, SR));
ghurni_mixer_set_rpm(mx2, f64_from(1500));
var wide = vec_new();
var narrow = vec_new();
var wi = 0;
while (wi < 512) { vec_push(wide, f64_from(7)); wi = wi + 1; }   # sentinel
var ni = 0;
while (ni < 256) { vec_push(narrow, 0); ni = ni + 1; }
ghurni_mixer_process_block_stereo(mx2, wide, narrow);
assert_eq(vec_get(wide, 511), f64_from(7), "tail sentinel survives at [511]");
assert_eq(vec_get(wide, 256), f64_from(7), "tail sentinel survives at [256] (first past len)");
assert_neq(vec_get(wide, 0), f64_from(7), "head WAS written (sentinel overwritten)");

# ================================================================
test_group("transmission: empty ratios is accepted, current_ratio falls back to 1.0");
# rust-old/src/transmission.rs:48 never validates `ratios`; :99-104 falls back.
var empty = vec_new();
var tr_e = ghurni_transmission_new(empty, 24, SR);
assert_eq(ghurni_is_err(tr_e), 0, "empty ratios vec is accepted (oracle parity)");
assert_eq(vec_len(GhTransmission_ratios(tr_e)), 0, "stored ratios stay empty");
assert_eq(ghurni_transmission_current_ratio(tr_e), F64_ONE, "current_ratio falls back to 1.0");
# shift_to on an empty box cannot move the gear.
ghurni_transmission_shift_to(tr_e, 0);
assert_eq(GhTransmission_current_gear(tr_e), 0, "shift_to(0) on empty ratios is a no-op");

# ================================================================
test_group("all 12 presets: stored parameters (rust-old/src/presets.rs)");
# Nothing pinned a single preset value before 2.0.3 -- only 4 were called at
# all, and only for has-energy. A typo in any number below was invisible.
var p_v8 = ghurni_preset_v8_muscle_car(SR);
assert_eq(GhEngine_engine_type(p_v8), GH_ENGINE_GASOLINE, "v8_muscle_car is Gasoline");
assert_eq(GhEngine_cylinders(p_v8), 8, "v8_muscle_car has 8 cylinders");
# Cross-plane firing order: uneven intervals are what create the burble, so the
# exact sequence matters -- an even 0/90/180/... split would sound wrong.
var v8o = GhEngine_firing_offsets(p_v8);
assert_eq(vec_len(v8o), 8, "v8 firing order has 8 entries");
assert_eq(vec_get(v8o, 0), 0, "v8 order[0] = 0");
assert_eq(vec_get(v8o, 1), f64_from(90), "v8 order[1] = 90");
assert_eq(vec_get(v8o, 2), f64_from(270), "v8 order[2] = 270");
assert_eq(vec_get(v8o, 3), f64_from(180), "v8 order[3] = 180");
assert_eq(vec_get(v8o, 4), f64_from(540), "v8 order[4] = 540");
assert_eq(vec_get(v8o, 5), f64_from(630), "v8 order[5] = 630");
assert_eq(vec_get(v8o, 6), f64_from(450), "v8 order[6] = 450");
assert_eq(vec_get(v8o, 7), f64_from(360), "v8 order[7] = 360");
assert_eq(GhEngine_rpm(p_v8), f64_from(800), "v8 idles at 800 rpm");
assert_eq(GhEngine_load(p_v8), 0.1, "v8 load 0.1");

var p_i4 = ghurni_preset_inline4_economy(SR);
assert_eq(GhEngine_engine_type(p_i4), GH_ENGINE_GASOLINE, "inline4 is Gasoline");
assert_eq(GhEngine_cylinders(p_i4), 4, "inline4 has 4 cylinders");

var p_dt = ghurni_preset_diesel_truck(SR);
assert_eq(GhEngine_engine_type(p_dt), GH_ENGINE_DIESEL, "diesel_truck is Diesel");
assert_eq(GhEngine_cylinders(p_dt), 6, "diesel_truck has 6 cylinders");
assert_eq(GhEngine_rpm(p_dt), f64_from(700), "diesel_truck idles at 700 rpm");
assert_eq(GhEngine_load(p_dt), 0.2, "diesel_truck load 0.2");

var p_ms = ghurni_preset_motorcycle_single(SR);
assert_eq(GhEngine_engine_type(p_ms), GH_ENGINE_TWO_STROKE, "motorcycle_single is TwoStroke");
assert_eq(GhEngine_cylinders(p_ms), 1, "motorcycle_single has 1 cylinder");

var p_ev = ghurni_preset_electric_vehicle(SR);
assert_eq(GhMotor_motor_type(p_ev), GH_MOTOR_BRUSHLESS, "electric_vehicle is Brushless");
assert_eq(GhMotor_poles(p_ev), 8, "electric_vehicle has 8 poles");

var p_tc = ghurni_preset_turbocharger(SR);
assert_eq(GhForcedInduction_induction_type(p_tc), GH_INDUCTION_TURBO, "turbocharger is Turbo");
assert_eq(GhForcedInduction_drive_ratio(p_tc), 2.5, "turbocharger drive_ratio 2.5");
assert_eq(GhForcedInduction_spool_inertia(p_tc), F64_ONE, "turbocharger spool_inertia 1.0");

var p_sc = ghurni_preset_supercharger(SR);
assert_eq(GhForcedInduction_induction_type(p_sc), GH_INDUCTION_SUPERCHARGER, "supercharger is Supercharger");
assert_eq(GhForcedInduction_drive_ratio(p_sc), 1.5, "supercharger drive_ratio 1.5");
# The preset passes 0.01, but Supercharger OVERRIDES spool_inertia to 0.01
# unconditionally (forced_induction.rs:70, "Near-instant response") -- so the
# argument is inert. Pinned so the inertness is visible, not accidental.
assert_eq(GhForcedInduction_spool_inertia(p_sc), 0.01, "supercharger spool_inertia forced to 0.01");

var p_m5 = ghurni_preset_manual_5speed(SR);
var r5 = GhTransmission_ratios(p_m5);
assert_eq(vec_len(r5), 5, "manual_5speed has 5 ratios");
assert_eq(vec_get(r5, 0), 3.5, "5speed ratio[0] 3.5");
assert_eq(vec_get(r5, 1), 2.1, "5speed ratio[1] 2.1");
assert_eq(vec_get(r5, 2), 1.4, "5speed ratio[2] 1.4");
assert_eq(vec_get(r5, 3), F64_ONE, "5speed ratio[3] 1.0");
assert_eq(vec_get(r5, 4), 0.8, "5speed ratio[4] 0.8");
assert_eq(GhTransmission_output_teeth(p_m5), 24, "5speed output_teeth 24");

var p_m6 = ghurni_preset_manual_6speed(SR);
var r6 = GhTransmission_ratios(p_m6);
assert_eq(vec_len(r6), 6, "manual_6speed has 6 ratios");
assert_eq(vec_get(r6, 0), 3.8, "6speed ratio[0] 3.8");
assert_eq(vec_get(r6, 1), 2.3, "6speed ratio[1] 2.3");
assert_eq(vec_get(r6, 2), 1.6, "6speed ratio[2] 1.6");
assert_eq(vec_get(r6, 3), 1.2, "6speed ratio[3] 1.2");
assert_eq(vec_get(r6, 4), 0.95, "6speed ratio[4] 0.95");
assert_eq(vec_get(r6, 5), 0.78, "6speed ratio[5] 0.78");
assert_eq(GhTransmission_output_teeth(p_m6), 28, "6speed output_teeth 28");

var p_sg = ghurni_preset_steel_spur_gear(40, SR);
assert_eq(GhGear_material(p_sg), GH_GEAR_STEEL, "steel_spur_gear is Steel");
assert_eq(GhGear_teeth(p_sg), 40, "steel_spur_gear passes teeth through");

var p_it = ghurni_preset_industrial_turbine(SR);
assert_eq(GhTurbine_blades(p_it), 24, "industrial_turbine has 24 blades");
assert_eq(GhTurbine_duct_resonance(p_it), f64_from(600), "industrial_turbine duct 600 Hz");

var p_pr = ghurni_preset_propeller(SR);
assert_eq(GhTurbine_blades(p_pr), 3, "propeller has 3 blades");
assert_eq(GhTurbine_duct_resonance(p_pr), 0, "propeller is OPEN (duct 0)");

# ================================================================
test_group("smoother contract: smooth_time_s is tau, not a settling time");
# rust-old/src/smooth.rs:20 documents it as "Time constant in seconds (63% of
# the way to target)". coeff = exp(-1/(t*sr)), so after exactly t*sr samples the
# value has covered 1 - 1/e = 63.2% of the distance -- NOT arrived.
var sm = ghurni_smooth_new(0, F64_ONE, SR);      # tau = 1 s
ghurni_smooth_set_target(sm, F64_ONE);
var steps = 0;
while (steps < 44100) { ghurni_smooth_next_value(sm); steps = steps + 1; }
var after_tau = ghurni_smooth_current(sm);
assert_gt(after_tau, 0.63, "after one tau, ~63% of the way (lower bound)");
assert_lt(after_tau, 0.633, "after one tau, ~63% of the way (upper bound)");
assert_eq(ghurni_smooth_is_settled(sm), 0, "one tau is NOT settled");
# t <= 0 or sr <= 0 -> coeff 0 -> snaps instantly.
var sm0 = ghurni_smooth_new(0, 0, SR);
ghurni_smooth_set_target(sm0, F64_ONE);
assert_eq(ghurni_smooth_next_value(sm0), F64_ONE, "zero smooth time snaps instantly");
assert_eq(ghurni_smooth_is_settled(sm0), 1, "snapped smoother reports settled");
assert_eq(ghurni_smooth_target(sm0), F64_ONE, "target() reads back");

# ================================================================
test_group("setters silently no-op out of range (oracle parity, not a defect)");
# rust-old/src/mixer.rs:74,80 use `if let Some(ch) = self.channels.get_mut(index)`
# and engine.rs:163 uses `if offsets.len() == self.cylinders`. All three IGNORE a
# bad argument and return nothing -- no error, no panic. That is the contract the
# port reproduces, and it is the shape 2.0.2 hunted (a call that reports success
# while doing nothing), so it is pinned here deliberately rather than "fixed".
var nm = ghurni_mixer_new();
var ng = ghurni_gear_new(32, GH_GEAR_STEEL, SR);
var nidx = ghurni_mixer_add_channel(nm, "g", GH_KIND_GEAR, ng);
assert_eq(nidx, 0, "one channel at index 0");
var nch = vec_get(GhMixer_channels(nm), 0);
ghurni_mixer_set_channel_gain(nm, 0, 0.25);
assert_eq(GhMixerChannel_gain(nch), 0.25, "in-range gain is applied");
ghurni_mixer_set_channel_gain(nm, 99, 0.9);
assert_eq(GhMixerChannel_gain(nch), 0.25, "out-of-range index is a silent no-op");
ghurni_mixer_set_channel_gain(nm, 0 - 1, 0.9);
assert_eq(GhMixerChannel_gain(nch), 0.25, "negative index is a silent no-op");
# Gain is clamped at 0 from below (gain.max(0.0)), not rejected.
ghurni_mixer_set_channel_gain(nm, 0, f64_neg(F64_ONE));
assert_eq(GhMixerChannel_gain(nch), 0, "negative gain clamps to 0, not an error");
# Pan clamps to [-1, 1].
ghurni_mixer_set_channel_pan(nm, 0, f64_from(5));
assert_eq(GhMixerChannel_pan(nch), F64_ONE, "pan clamps down to +1");
ghurni_mixer_set_channel_pan(nm, 0, f64_from(0 - 5));
assert_eq(GhMixerChannel_pan(nch), f64_neg(F64_ONE), "pan clamps up to -1");
# set_firing_order ignores a length mismatch entirely.
var fo_eng = ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR);
var wrong = vec_new();
vec_push(wrong, 0); vec_push(wrong, f64_from(180));
ghurni_engine_set_firing_order(fo_eng, wrong);
assert_eq(vec_len(GhEngine_firing_offsets(fo_eng)), 4, "wrong-length firing order ignored");
assert_eq(vec_get(GhEngine_firing_offsets(fo_eng), 1), f64_from(180), "the even-firing default survives");

# ================================================================
test_group("GhSmoothedParam serde roundtrip");
# The sibling POD structs (GhDcBlocker in foundations.tcyr, GhEvent there too)
# had their derived roundtrip tested; this one did not.
var sp = ghurni_smooth_new(0.25, 0.05, SR);
ghurni_smooth_set_target(sp, 0.75);
ghurni_smooth_next_value(sp);
var spb = str_builder_new();
GhSmoothedParam_to_json(sp, spb);
var spjs = str_data(str_builder_build(spb));
var sp2 = GhSmoothedParam_from_json_str(spjs);
assert_eq(GhSmoothedParam_current(sp2), GhSmoothedParam_current(sp), "current roundtrips");
assert_eq(GhSmoothedParam_target(sp2), GhSmoothedParam_target(sp), "target roundtrips");
assert_eq(GhSmoothedParam_coeff(sp2), GhSmoothedParam_coeff(sp), "coeff roundtrips");
# f64 fields are stored as i64 BIT PATTERNS precisely so this is lossless.
assert_neq(GhSmoothedParam_coeff(sp), 0, "coeff is a real value (not a vacuous 0 == 0)");

# ================================================================
test_group("RPM loudness law: rest is quiet, and louder means faster (ADR-005)");
# This group used to pin the DEFECT -- motor was as loud stopped as running and
# belt_drive was louder stopped -- deliberately, so the fix could not land
# silently. 2.1.0 landed it (ADR-005), so these are now the INVARIANT.
#
# Note the rest level is not always exactly zero: each synth clamps its own rpm,
# and engine's floor is 100 rpm (an engine at 0 is not running, it is off),
# gear's and turbine's are 1 rpm. Those floors are oracle parity. So the
# invariant is "rest is a small fraction of running", plus exact silence for the
# synths whose floor really is 0.
fn rest_rms(v) {
    var n = vec_len(v);
    if (n == 0) { return 0; }
    var acc = 0;
    var i = 0;
    while (i < n) { var x = vec_get(v, i); acc = f64_add(acc, f64_mul(x, x)); i = i + 1; }
    return f64_sqrt(f64_div(acc, f64_from(n)));
}

# --- exact silence, for the synths whose rpm floor is 0 ---
assert_eq(rest_rms(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_BRUSHLESS, 4, SR), 0, 0.5, 0.1)),
          0, "motor is EXACTLY silent at 0 rpm");
assert_eq(rest_rms(ghurni_belt_drive_synthesize(ghurni_belt_drive_new(f64_from(120), 0.6, SR), 0, 0.1)),
          0, "belt_drive is EXACTLY silent at 0 rpm");
assert_eq(rest_rms(ghurni_differential_synthesize(ghurni_differential_new(41, 11, SR), 0, 0.1)),
          0, "differential is EXACTLY silent at 0 rpm");
var tr_rest = vec_new();
vec_push(tr_rest, f64_from(3)); vec_push(tr_rest, f64_from(2));
assert_eq(rest_rms(ghurni_transmission_synthesize(ghurni_transmission_new(tr_rest, 40, SR), 0, 0.1)),
          0, "transmission is EXACTLY silent at 0 rpm");
assert_eq(rest_rms(ghurni_chain_drive_synthesize(ghurni_chain_drive_new(110, 16, SR), 0, 0.1)),
          0, "chain_drive is EXACTLY silent at 0 rpm");
assert_eq(rest_rms(ghurni_forced_induction_synthesize(
    ghurni_forced_induction_new(GH_INDUCTION_TURBO, f64_from(2), 0.3, SR), 0, 0.5, 0.1)),
          0, "forced_induction is EXACTLY silent at 0 rpm");

# --- rest is a small fraction of running, for the synths with an rpm floor ---
var m_rest = rest_rms(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_BRUSHLESS, 4, SR), 0, 0.5, 0.1));
var m_run  = rest_rms(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_BRUSHLESS, 4, SR), f64_from(3000), 0.5, 0.1));
assert_gt(m_run, 0.01, "motor running produces real signal (not a vacuous compare)");
assert_lt(m_rest, f64_mul(m_run, 0.05), "motor at rest is under 5% of running");

var b_rest = rest_rms(ghurni_belt_drive_synthesize(ghurni_belt_drive_new(f64_from(120), 0.6, SR), 0, 0.1));
var b_run  = rest_rms(ghurni_belt_drive_synthesize(ghurni_belt_drive_new(f64_from(120), 0.6, SR), f64_from(2000), 0.1));
assert_gt(b_run, 0.01, "belt running produces real signal");
assert_lt(b_rest, f64_mul(b_run, 0.05), "belt at rest is under 5% of running");

var g_rest = rest_rms(ghurni_gear_synthesize(ghurni_gear_new(32, GH_GEAR_STEEL, SR), 0, 0.1));
var g_run  = rest_rms(ghurni_gear_synthesize(ghurni_gear_new(32, GH_GEAR_STEEL, SR), f64_from(1500), 0.1));
assert_gt(g_run, 0.01, "gear running produces real signal");
assert_lt(g_rest, f64_mul(g_run, 0.05), "gear at rest is under 5% of running (1 rpm floor)");

var t_rest = rest_rms(ghurni_turbine_synthesize(ghurni_turbine_new(12, f64_from(600), SR), 0, 0.1));
var t_run  = rest_rms(ghurni_turbine_synthesize(ghurni_turbine_new(12, f64_from(600), SR), f64_from(8000), 0.1));
assert_gt(t_run, 0.01, "turbine running produces real signal");
assert_lt(t_rest, f64_mul(t_run, 0.05), "turbine at rest is under 5% of running (1 rpm floor)");

var e_rest = rest_rms(ghurni_engine_synthesize(ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR), 0, 0.5, 0.1));
var e_run  = rest_rms(ghurni_engine_synthesize(ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR), f64_from(3000), 0.5, 0.1));
assert_gt(e_run, 0.005, "engine running produces real signal");
assert_lt(e_rest, f64_mul(e_run, 0.2), "engine at rest is well under running (100 rpm idle floor)");

# --- MONOTONIC: faster must not be quieter. Three synths failed this before. ---
var m_lo = rest_rms(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_BRUSHLESS, 4, SR), f64_from(300), 0.5, 0.1));
assert_lt(m_lo, m_run, "motor: 300 rpm is quieter than 3000");
var c_lo = rest_rms(ghurni_chain_drive_synthesize(ghurni_chain_drive_new(110, 16, SR), f64_from(300), 0.1));
var c_hi = rest_rms(ghurni_chain_drive_synthesize(ghurni_chain_drive_new(110, 16, SR), f64_from(3000), 0.1));
assert_lt(c_lo, c_hi, "chain_drive: 300 rpm is quieter than 3000");
var b_lo = rest_rms(ghurni_belt_drive_synthesize(ghurni_belt_drive_new(f64_from(120), 0.6, SR), f64_from(200), 0.1));
assert_lt(b_lo, b_run, "belt_drive: 200 rpm is quieter than 2000");
var g_lo = rest_rms(ghurni_gear_synthesize(ghurni_gear_new(32, GH_GEAR_STEEL, SR), f64_from(150), 0.1));
assert_lt(g_lo, g_run, "gear: 150 rpm is quieter than 1500");

# --- clock is EXEMPT: a fixed-rate escapement, not RPM-driven (ADR-005) ---
var ck_a = rest_rms(ghurni_clock_synthesize(ghurni_clock_new(GH_CLOCK_WALL_CLOCK, SR), 0.2));
var ck_b = rest_rms(ghurni_clock_synthesize(ghurni_clock_new(GH_CLOCK_WALL_CLOCK, SR), 0.2));
assert_eq(ck_a, ck_b, "clock is deterministic");
assert_gt(ck_a, 0.001, "clock ticks regardless of rpm -- deliberately exempt from the law");

# ================================================================
test_group("ghurni_rpm_gain: the law itself (ADR-005)");
var REF = f64_from(1500);
assert_eq(ghurni_rpm_gain(0, REF), 0, "gain(0) = 0 exactly");
assert_eq(ghurni_rpm_gain(REF, REF), F64_ONE, "gain(ref) = 1.0 EXACTLY -- nominal audio is unchanged");
# 2r/(r+1): r=0.5 -> 0.6667, r=2 -> 1.3333
var half = ghurni_rpm_gain(f64_from(750), REF);
assert_gt(half, 0.6666, "gain(ref/2) ~ 0.6667");
assert_lt(half, 0.6667, "gain(ref/2) ~ 0.6667");
var dbl = ghurni_rpm_gain(f64_from(3000), REF);
assert_gt(dbl, 1.3333, "gain(2*ref) ~ 1.3333");
assert_lt(dbl, 1.3334, "gain(2*ref) ~ 1.3333");
# Monotonic and bounded by GHURNI_RPM_GAIN_MAX.
assert_lt(ghurni_rpm_gain(f64_from(150), REF), ghurni_rpm_gain(f64_from(750), REF), "monotonic (low)");
assert_lt(ghurni_rpm_gain(f64_from(3000), REF), ghurni_rpm_gain(f64_from(30000), REF), "monotonic (high)");
assert_lt(ghurni_rpm_gain(f64_from(100000000), REF), GHURNI_RPM_GAIN_MAX, "saturates below the +6 dB ceiling");
# NaN sink -- f64_clamp propagates NaN, this absorbs it.
assert_eq(ghurni_rpm_gain(f64_div(0, 0), REF), 0, "NaN rpm -> 0");
assert_eq(ghurni_rpm_gain(GHURNI_POS_INF, REF), 0, "+inf rpm -> 0");
assert_eq(ghurni_rpm_gain(GHURNI_NEG_INF, REF), 0, "-inf rpm -> 0");
assert_eq(ghurni_rpm_gain(f64_neg(f64_from(500)), REF), 0, "negative rpm -> 0");
assert_eq(ghurni_rpm_gain(f64_from(500), 0), 0, "zero reference -> 0, no divide by zero");

# ================================================================
test_group("ghurni_finite_clamp absorbs NaN where f64_clamp propagates it");
assert_eq(ghurni_finite_clamp(0.5, 0, F64_ONE), 0.5, "in-range value passes through");
assert_eq(ghurni_finite_clamp(f64_from(5), 0, F64_ONE), F64_ONE, "clamps down");
assert_eq(ghurni_finite_clamp(f64_neg(F64_ONE), 0, F64_ONE), 0, "clamps up");
assert_eq(ghurni_finite_clamp(f64_div(0, 0), 0, F64_ONE), 0, "NaN collapses to lo");
assert_eq(ghurni_finite_clamp(GHURNI_POS_INF, 0, F64_ONE), 0, "+inf collapses to lo");
assert_eq(ghurni_finite_clamp(GHURNI_NEG_INF, 0, F64_ONE), 0, "-inf collapses to lo");
# The reason it exists: f64_clamp does NOT do this.
assert_eq(ghurni_is_finite(f64_clamp(f64_div(0, 0), 0, F64_ONE)), 0, "f64_clamp really does propagate NaN");

# ================================================================
test_group("NaN at the parameter boundary renders finite audio (ADR-005)");
fn all_finite_buf(v) {
    var n = vec_len(v);
    if (n == 0) { return 0; }
    var i = 0;
    while (i < n) { if (ghurni_is_finite(vec_get(v, i)) == 0) { return 0; } i = i + 1; }
    return 1;
}
var NANV = f64_div(0, 0);
assert_eq(all_finite_buf(ghurni_engine_synthesize(ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR), NANV, 0.5, 0.05)), 1, "engine: NaN rpm");
assert_eq(all_finite_buf(ghurni_engine_synthesize(ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR), f64_from(3000), NANV, 0.05)), 1, "engine: NaN load");
assert_eq(all_finite_buf(ghurni_gear_synthesize(ghurni_gear_new(32, GH_GEAR_STEEL, SR), NANV, 0.05)), 1, "gear: NaN rpm");
assert_eq(all_finite_buf(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_BRUSHLESS, 8, SR), NANV, 0.5, 0.05)), 1, "motor: NaN rpm");
assert_eq(all_finite_buf(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_BRUSHLESS, 8, SR), f64_from(3000), NANV, 0.05)), 1, "motor: NaN load");
assert_eq(all_finite_buf(ghurni_turbine_synthesize(ghurni_turbine_new(12, f64_from(600), SR), NANV, 0.05)), 1, "turbine: NaN rpm");
assert_eq(all_finite_buf(ghurni_belt_drive_synthesize(ghurni_belt_drive_new(f64_from(120), 0.6, SR), NANV, 0.05)), 1, "belt: NaN rpm");
assert_eq(all_finite_buf(ghurni_forced_induction_synthesize(ghurni_forced_induction_new(GH_INDUCTION_TURBO, f64_from(2), 0.3, SR), NANV, 0.5, 0.05)), 1, "forced: NaN rpm");
assert_eq(all_finite_buf(ghurni_forced_induction_synthesize(ghurni_forced_induction_new(GH_INDUCTION_TURBO, f64_from(2), 0.3, SR), f64_from(5000), NANV, 0.05)), 1, "forced: NaN load");
# A NaN construction parameter must not poison the object either.
assert_eq(all_finite_buf(ghurni_belt_drive_synthesize(ghurni_belt_drive_new(NANV, NANV, SR), f64_from(2000), 0.05)), 1, "belt: NaN diameter + tension");

# ================================================================
test_group("seed resolution: float parameters reach the seed (ADR-005)");
fn streams_differ(a, b) {
    var i = 0;
    var d = 0;
    var nz = 0;
    while (i < 32) {
        var sa = noise_next_sample(a);
        var sb = noise_next_sample(b);
        if (sa != sb) { d = 1; }
        if (f64_abs(sa) != 0) { nz = 1; }
        i = i + 1;
    }
    if (nz == 0) { return 0 - 1; }
    return d;
}
# A bare f64_to keeps only whole units, so near-identical parameters collided.
assert_eq(streams_differ(GhTurbine_noise_gen(ghurni_turbine_new(12, f64_from(600), SR)),
                         GhTurbine_noise_gen(ghurni_turbine_new(12, 600.4, SR))), 1,
          "turbine: duct 600.0 vs 600.4 decorrelate");
assert_eq(streams_differ(GhBeltDrive_noise_gen(ghurni_belt_drive_new(f64_from(120), 0.6, SR)),
                         GhBeltDrive_noise_gen(ghurni_belt_drive_new(f64_from(120), 0.65, SR))), 1,
          "belt: tension 0.60 vs 0.65 decorrelate");
assert_eq(streams_differ(GhForcedInduction_noise_gen(ghurni_forced_induction_new(GH_INDUCTION_TURBO, f64_from(2), 0.3, SR)),
                         GhForcedInduction_noise_gen(ghurni_forced_induction_new(GH_INDUCTION_TURBO, 2.05, 0.3, SR))), 1,
          "turbo: ratio 2.0 vs 2.05 decorrelate");
# Determinism is preserved (ADR-003): identical parameters, identical stream.
assert_eq(streams_differ(GhTurbine_noise_gen(ghurni_turbine_new(12, f64_from(600), SR)),
                         GhTurbine_noise_gen(ghurni_turbine_new(12, f64_from(600), SR))), 0,
          "identical turbine parameters stay bit-identical");

# ================================================================
test_group("chain link count is audible (ADR-006)");
# `links` was stored, clamped and documented ("typically 100-120") but affected
# NOTHING: engagement frequency uses sprocket_teeth, so a 40-link chain and a
# 500-link chain rendered identically apart from their noise seed. A real chain
# is a closed loop, so link-to-link variation recurs once per lap.
fn buf_differs(a, b) {
    var n = vec_len(a);
    if (n != vec_len(b)) { return 1; }
    var i = 0;
    while (i < n) { if (vec_get(a, i) != vec_get(b, i)) { return 1; } i = i + 1; }
    return 0;
}
var ch60  = ghurni_chain_drive_synthesize(ghurni_chain_drive_new(60, 16, SR), f64_from(3000), 0.3);
var ch240 = ghurni_chain_drive_synthesize(ghurni_chain_drive_new(240, 16, SR), f64_from(3000), 0.3);
assert_gt(vec_len(ch60), 0, "chain rendered real audio (not a vacuous compare)");
assert_eq(buf_differs(ch60, ch240), 1, "60-link and 240-link chains sound DIFFERENT");
# ...and the same link count is still deterministic (ADR-003).
var ch60b = ghurni_chain_drive_synthesize(ghurni_chain_drive_new(60, 16, SR), f64_from(3000), 0.3);
assert_eq(buf_differs(ch60, ch60b), 0, "identical link counts stay bit-identical");
# The lap modulation must not silence the chain or push it non-finite.
assert_eq(all_finite_buf(ch60), 1, "lap-modulated chain is finite");
assert_gt(rest_rms(ch60), 0.001, "lap-modulated chain still has energy");

# ================================================================
test_group("clock tick and tock differ (ADR-006)");
# An escapement alternates between two pallets and the two impacts are not the
# same sound -- that asymmetry is why it is called "tick-tock". Until 2.2.0 every
# beat was identical and perfectly periodic, which read as a metronome.
# WallClock ticks at 2 Hz, so beats land every 22050 samples at 44.1 kHz.
fn beat_peak(v, beat) {
    var start = beat * 22050;
    var pk = 0;
    var j = 0;
    while (j < 2000) {
        var a = f64_abs(vec_get(v, start + j));
        if (f64_gt(a, pk) == 1) { pk = a; }
        j = j + 1;
    }
    return pk;
}
var ck = ghurni_clock_synthesize(ghurni_clock_new(GH_CLOCK_WALL_CLOCK, SR), f64_from(2));
assert_eq(vec_len(ck), 88200, "2 s of wall clock at 44.1 kHz");
var b0 = beat_peak(ck, 0);
var b1 = beat_peak(ck, 1);
var b2 = beat_peak(ck, 2);
var b3 = beat_peak(ck, 3);
assert_gt(b0, 0.05, "beat 0 is a real impact (not a vacuous compare)");
assert_gt(b1, 0.05, "beat 1 is a real impact");
# Odd beats (tocks) are the lighter pallet: softer than the ticks either side.
assert_lt(b1, b0, "tock is softer than the tick before it");
assert_lt(b1, b2, "tock is softer than the tick after it");
assert_lt(b3, b2, "the pattern repeats: beat 3 is softer than beat 2");
# ...and it is an ALTERNATION, not a decay: tick 2 is not weaker than tick 0.
assert_gt(b2, f64_mul(b0, 0.9), "ticks stay at tick level -- this alternates, it does not fade");

var rc = assert_summary();
syscall(60, rc);
