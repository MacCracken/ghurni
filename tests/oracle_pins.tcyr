# oracle_pins.tcyr -- 2.0.3 "Pin the Oracle".
#
# Every assertion here pins a value or contract that ONLY the Rust oracle used
# to prove. That oracle was RETIRED in 2.0.4, so these assertions are now the
# specification -- there is nothing else left to check them against.
#
# Each expected value below was read out of the `rust-old/src/*.rs` line cited
# beside it, NOT observed from what ghurni prints. Those paths still resolve in
# git history (`git show 2.0.3:rust-old/src/gear.rs`) and are kept deliberately
# as provenance. A value transcribed from current output would freeze whatever
# is wrong today as "correct" -- the exact failure mode that let GHURNI_DB_SCALE
# ship 76.9x wrong through a green suite.
#
# These are structural / numeric assertions on purpose. `audio_all_finite` and
# `audio_has_energy` hold for almost any value and pin almost nothing; nothing
# in this file leans on them alone.

include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"
include "src/smooth.cyr"
include "src/event.cyr"
include "src/traits.cyr"
include "src/engine.cyr"
include "src/gear.cyr"
include "src/motor.cyr"
include "src/turbine.cyr"
include "src/clock.cyr"
include "src/transmission.cyr"
include "src/differential.cyr"
include "src/forced_induction.cyr"
include "src/belt_drive.cyr"
include "src/chain_drive.cyr"
include "src/mixer.cyr"
include "src/presets.cyr"

alloc_init();

var SR = f64_from(44100);

# ================================================================
test_group("gear material properties (rust-old/src/gear.rs:33-40)");
# properties() -> (resonance_hz, decay_s, brightness). Inline literals in
# ghurni_gear_new, so they are read back through the accessors.
var g_steel = ghurni_gear_new(32, GH_GEAR_STEEL, SR);
assert_eq(GhGear_resonance(g_steel), f64_from(3500), "Steel resonance 3500");
assert_eq(GhGear_decay(g_steel), 0.08, "Steel decay 0.08");
assert_eq(GhGear_brightness(g_steel), 0.9, "Steel brightness 0.9");
var g_iron = ghurni_gear_new(32, GH_GEAR_CAST_IRON, SR);
assert_eq(GhGear_resonance(g_iron), f64_from(2000), "CastIron resonance 2000");
assert_eq(GhGear_decay(g_iron), 0.04, "CastIron decay 0.04");
assert_eq(GhGear_brightness(g_iron), 0.5, "CastIron brightness 0.5");
var g_brass = ghurni_gear_new(32, GH_GEAR_BRASS, SR);
assert_eq(GhGear_resonance(g_brass), f64_from(2800), "Brass resonance 2800");
assert_eq(GhGear_decay(g_brass), 0.06, "Brass decay 0.06");
assert_eq(GhGear_brightness(g_brass), 0.7, "Brass brightness 0.7");
var g_nylon = ghurni_gear_new(32, GH_GEAR_NYLON, SR);
assert_eq(GhGear_resonance(g_nylon), f64_from(1000), "Nylon resonance 1000");
assert_eq(GhGear_decay(g_nylon), 0.01, "Nylon decay 0.01");
assert_eq(GhGear_brightness(g_nylon), 0.2, "Nylon brightness 0.2");
# teeth.max(4) -- lower bound only, matching the oracle (gear.rs:72,
# documented "Number of teeth (4+)"). NOT a both-ends clamp: every sibling
# constructor clamps both, but adding an upper bound here would DIVERGE.
assert_eq(GhGear_teeth(ghurni_gear_new(1, GH_GEAR_STEEL, SR)), 4, "teeth clamps up to 4");
assert_eq(GhGear_teeth(ghurni_gear_new(0 - 5, GH_GEAR_STEEL, SR)), 4, "negative teeth clamps to 4");
assert_eq(GhGear_teeth(ghurni_gear_new(100000, GH_GEAR_STEEL, SR)), 100000, "huge teeth NOT clamped (oracle parity)");
# mesh_frequency = (rpm/60) * teeth (gear.rs). 32 teeth @ 1500 rpm = 800 Hz exactly.
assert_eq(ghurni_gear_mesh_frequency(g_steel, f64_from(1500)), f64_from(800), "32 teeth @1500 rpm = 800 Hz");

