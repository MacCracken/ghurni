# spectral.tcyr -- FFT assertions that the rendered audio actually sits at the
# frequency the physics says it should (2.0.3).
#
# WHY THIS SUITE EXISTS. ghurni's entire thesis is "RPM is the fundamental
# parameter": mesh frequency is (rpm/60) x teeth, blade pass is (rpm/60) x
# blades, EM hum is (rpm/60) x poles. Until now NOTHING checked that the
# rendered signal actually lands there. Every audio assertion in the suite was
# finite / has-energy / an energy ordering, all of which hold for a synth
# emitting the wrong pitch entirely -- a transposed gear whine, a blade-pass
# term wired to ring teeth instead of pinion, an off-by-60 in an rpm-to-Hz
# conversion. This is the class that catches those.
#
# WHAT IT DOES NOT CATCH, so nobody over-trusts it: a peak-bin assertion pins
# FREQUENCY, not amplitude or envelope shape. The 2.0.1 GHURNI_DB_SCALE
# miscompile flattened decay envelopes 187x without moving any peak -- goldens.tcyr
# is what catches that. The two suites are complementary.
#
# METHOD. naad's `fft_magnitudes` returns n/2+1 magnitude bins scaled by 1/n and
# requires a POWER-OF-TWO input, so blocks are 8192 (not the 4410/2205 the rest
# of the suite uses). Bin width is 44100/8192 = 5.383 Hz. Each synth is settled
# with one discarded block first, because set_rpm ramps through GhSmoothedParam
# and the first block is still climbing. Expected frequencies are derived from
# the ORACLE's formulas, never read off the FFT.

include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"
include "src/smooth.cyr"
include "src/event.cyr"
include "src/traits.cyr"
include "src/engine.cyr"
include "src/gear.cyr"
include "src/motor.cyr"
include "src/turbine.cyr"
include "src/clock.cyr"
include "src/transmission.cyr"
include "src/differential.cyr"
include "src/forced_induction.cyr"
include "src/belt_drive.cyr"
include "src/chain_drive.cyr"
include "src/mixer.cyr"
include "src/presets.cyr"

alloc_init();

var SR = f64_from(44100);
var SPEC_N = 8192;

fn spec_block() {
    var v = vec_new();
    var i = 0;
    while (i < SPEC_N) { vec_push(v, 0); i = i + 1; }
    return v;
}

# Index of the largest magnitude bin, skipping DC (bin 0), which carries any
# residual offset rather than a tone.
fn spec_peak_bin(v) {
    var mags = fft_magnitudes(v);
    var n = vec_len(mags);
    var best = 0;
    var bi = 0;
    var i = 1;
    while (i < n) {
        var m = vec_get(mags, i);
        if (f64_gt(m, best) == 1) { best = m; bi = i; }
        i = i + 1;
    }
    return bi;
}

fn spec_peak_mag(v) {
    var mags = fft_magnitudes(v);
    var n = vec_len(mags);
    var best = 0;
    var i = 1;
    while (i < n) {
        var m = vec_get(mags, i);
        if (f64_gt(m, best) == 1) { best = m; }
        i = i + 1;
    }
    return best;
}

# The bin a given frequency falls in: f * N / sample_rate, rounded.
fn spec_bin_for(hz) {
    return f64_to(f64_add(f64_div(f64_mul(hz, f64_from(SPEC_N)), SR), 0.5));
}

# Assert the dominant bin is within +/-1 of the physics-derived one. One bin is
# 5.383 Hz here, so this is a ~0.7% tolerance on an 800 Hz tone -- tight enough
# to catch a wrong multiplier, loose enough to survive windowing leakage.
fn assert_peak_at(v, want_hz, name) {
    var got = spec_peak_bin(v);
    var want = spec_bin_for(want_hz);
    var d = got - want;
    if (d < 0) { d = 0 - d; }
    assert_lte(d, 1, name);
    return 0;
}

# ================================================================
test_group("gear mesh frequency = (rpm/60) x teeth");
# 32 teeth @ 1500 rpm = 800 Hz. @ 3000 rpm = 1600 Hz.
var g = ghurni_gear_new(32, GH_GEAR_STEEL, SR);
ghurni_gear_set_rpm(g, f64_from(1500));
var gw = spec_block();
ghurni_gear_process_block(g, gw);
var gb = spec_block();
ghurni_gear_process_block(g, gb);
# Guard against a vacuous compare: there must BE a peak to find.
assert_gt(spec_peak_mag(gb), 0.0001, "gear produced a real spectral peak");
assert_peak_at(gb, f64_from(800), "gear 32t @1500 rpm peaks at 800 Hz");
# Frequency must SCALE with rpm -- this is the thesis, stated as an assertion.
ghurni_gear_set_rpm(g, f64_from(3000));
var gw2 = spec_block();
ghurni_gear_process_block(g, gw2);
var gb2 = spec_block();
ghurni_gear_process_block(g, gb2);
assert_peak_at(gb2, f64_from(1600), "doubling rpm doubles the mesh frequency");
# ...and with tooth count, independently.
var g16 = ghurni_gear_new(16, GH_GEAR_STEEL, SR);
ghurni_gear_set_rpm(g16, f64_from(1500));
var gw3 = spec_block();
ghurni_gear_process_block(g16, gw3);
var gb3 = spec_block();
ghurni_gear_process_block(g16, gb3);
assert_peak_at(gb3, f64_from(400), "halving teeth halves the mesh frequency");

# ================================================================
test_group("motor EM hum = (rpm/60) x poles");
# 8 poles @ 1500 rpm = 200 Hz.
var m = ghurni_motor_new(GH_MOTOR_BRUSHLESS, 8, SR);
ghurni_motor_set_rpm(m, f64_from(1500));
var mw = spec_block();
ghurni_motor_process_block(m, mw);
var mb = spec_block();
ghurni_motor_process_block(m, mb);
assert_gt(spec_peak_mag(mb), 0.0001, "motor produced a real spectral peak");
assert_peak_at(mb, f64_from(200), "motor 8-pole @1500 rpm peaks at 200 Hz");
# 4 poles at the same rpm must halve it.
var m4 = ghurni_motor_new(GH_MOTOR_BRUSHLESS, 4, SR);
ghurni_motor_set_rpm(m4, f64_from(1500));
var mw4 = spec_block();
ghurni_motor_process_block(m4, mw4);
var mb4 = spec_block();
ghurni_motor_process_block(m4, mb4);
assert_peak_at(mb4, f64_from(100), "motor 4-pole @1500 rpm peaks at 100 Hz");

# ================================================================
test_group("turbine blade pass = (rpm/60) x blades");
# 12 blades @ 8000 rpm = 1600 Hz. Open (no duct) so the duct tone cannot win.
var t = ghurni_turbine_new(12, 0, SR);
ghurni_turbine_set_rpm(t, f64_from(8000));
var tw = spec_block();
ghurni_turbine_process_block(t, tw);
var tb = spec_block();
ghurni_turbine_process_block(t, tb);
assert_gt(spec_peak_mag(tb), 0.0001, "turbine produced a real spectral peak");
assert_peak_at(tb, f64_from(1600), "turbine 12-blade @8000 rpm peaks at 1600 Hz");
# 3-blade propeller at the same rpm = 400 Hz.
var t3 = ghurni_turbine_new(3, 0, SR);
ghurni_turbine_set_rpm(t3, f64_from(8000));
var tw3 = spec_block();
ghurni_turbine_process_block(t3, tw3);
var tb3 = spec_block();
ghurni_turbine_process_block(t3, tb3);
assert_peak_at(tb3, f64_from(400), "turbine 3-blade @8000 rpm peaks at 400 Hz");

# ================================================================
test_group("differential whine uses PINION teeth, not ring");
# mesh = (rpm/60) x pinion. 11 pinion @ 3000 rpm = 550 Hz.
# With ring (41) it would be 2050 Hz -- so this assertion alone catches a swap,
# and it catches it in the RENDERED AUDIO rather than in the accessor.
var d = ghurni_differential_new(41, 11, SR);
ghurni_differential_set_rpm(d, f64_from(3000));
var dw = spec_block();
ghurni_differential_process_block(d, dw);
var db = spec_block();
ghurni_differential_process_block(d, db);
assert_gt(spec_peak_mag(db), 0.0001, "differential produced a real spectral peak");
assert_peak_at(db, f64_from(550), "differential 11-pinion @3000 rpm peaks at 550 Hz");
var ring_bin = spec_bin_for(f64_from(2050));
var got_bin = spec_peak_bin(db);
assert_neq(got_bin, ring_bin, "differential peak is NOT at the ring-teeth frequency");

# ================================================================
test_group("mesh harmonics: material brightness shapes the spectrum (ADR-006)");
# Until 2.2.0 every gear-mesh whine in the library was a single pure SINE -- the
# one thing meshing gears never sound like. gear/transmission/differential now
# use a 3-partial additive mesh, and gear's upper partials scale with the
# existing per-material `brightness`, so material finally changes TIMBRE and not
# just the resonance filter.
fn bin_mag_at(v, hz) {
    var mags = fft_magnitudes(v);
    var b = spec_bin_for(hz);
    if (b >= vec_len(mags)) { return 0; }
    return vec_get(mags, b);
}
fn gear_h2_ratio(material) {
    var g = ghurni_gear_new(32, material, SR);
    ghurni_gear_set_rpm(g, f64_from(1500));
    var w = spec_block();
    ghurni_gear_process_block(g, w);
    var b = spec_block();
    ghurni_gear_process_block(g, b);
    var f1 = bin_mag_at(b, f64_from(800));
    var f2 = bin_mag_at(b, f64_from(1600));
    return f64_div(f2, f1);
}
# 32 teeth @1500 rpm -> 800 Hz mesh, so the 2nd harmonic sits at 1600 Hz.
var h2_steel = gear_h2_ratio(GH_GEAR_STEEL);      # brightness 0.9
var h2_brass = gear_h2_ratio(GH_GEAR_BRASS);      # brightness 0.7
var h2_iron  = gear_h2_ratio(GH_GEAR_CAST_IRON);  # brightness 0.5
var h2_nylon = gear_h2_ratio(GH_GEAR_NYLON);      # brightness 0.2
assert_gt(h2_steel, 0.4, "steel gear has a strong 2nd harmonic (it is not a sine)");
assert_lt(h2_steel, h2_steel + 1, "reference read succeeded");
# Strictly ordered by brightness -- this is the property that makes material audible.
assert_lt(h2_brass, h2_steel, "brass is duller than steel");
assert_lt(h2_iron, h2_brass, "cast iron is duller than brass");
assert_lt(h2_nylon, h2_iron, "nylon is the dullest");
assert_lt(h2_nylon, 0.2, "nylon is close to a pure sine");
# The FUNDAMENTAL must not move -- this is a timbre change, not a pitch change.
var gsteel = ghurni_gear_new(32, GH_GEAR_STEEL, SR);
ghurni_gear_set_rpm(gsteel, f64_from(1500));
var gw2 = spec_block();
ghurni_gear_process_block(gsteel, gw2);
var gb2 = spec_block();
ghurni_gear_process_block(gsteel, gb2);
assert_peak_at(gb2, f64_from(800), "gear still peaks at the mesh fundamental");

# ================================================================
test_group("HYBRID is an electric drive, not a quiet petrol engine (ADR-006)");
# GH_ENGINE_HYBRID is documented "electric-with-whine". Until 2.2.0 it ran the
# full combustion path and merely used different resonance constants.
# EM whine = (rpm/60) * 8 poles: 3000 rpm -> 400 Hz, 1500 rpm -> 200 Hz.
var hy = ghurni_engine_new(GH_ENGINE_HYBRID, 4, SR);
ghurni_engine_set_rpm(hy, f64_from(3000));
ghurni_engine_set_load(hy, 0.7);
var hw = spec_block();
ghurni_engine_process_block(hy, hw);
var hb = spec_block();
ghurni_engine_process_block(hy, hb);
assert_gt(spec_peak_mag(hb), 0.0001, "hybrid produces a real spectral peak");
assert_peak_at(hb, f64_from(400), "hybrid @3000 rpm peaks at the 400 Hz EM whine");
var hy2 = ghurni_engine_new(GH_ENGINE_HYBRID, 4, SR);
ghurni_engine_set_rpm(hy2, f64_from(1500));
ghurni_engine_set_load(hy2, 0.7);
var hw2 = spec_block();
ghurni_engine_process_block(hy2, hw2);
var hb2 = spec_block();
ghurni_engine_process_block(hy2, hb2);
assert_peak_at(hb2, f64_from(200), "hybrid @1500 rpm peaks at 200 Hz -- whine tracks rpm");
# A petrol engine at the same speed must NOT land there.
var pet = ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR);
ghurni_engine_set_rpm(pet, f64_from(3000));
ghurni_engine_set_load(pet, 0.7);
var pw = spec_block();
ghurni_engine_process_block(pet, pw);
var pb = spec_block();
ghurni_engine_process_block(pet, pb);
assert_neq(spec_peak_bin(pb), spec_peak_bin(hb), "gasoline and hybrid no longer share a spectrum");

# ================================================================
test_group("turbo and supercharger are spectrally distinct (ADR-006)");
# Until 2.2.0 both whined at plain shaft rate and differed only in spool lag.
# Now: turbo = 10 blades, supercharger = 3 lobes, so the turbo sits 10/3 higher.
fn fi_peak_bin(ty) {
    var f = ghurni_forced_induction_new(ty, f64_from(2), 0.1, SR);
    ghurni_forced_induction_set_rpm(f, f64_from(6000));
    ghurni_forced_induction_set_load(f, 0.9);
    var a = spec_block();
    ghurni_forced_induction_process_block(f, a);
    ghurni_forced_induction_process_block(f, a);
    ghurni_forced_induction_process_block(f, a);
    var b = spec_block();
    ghurni_forced_induction_process_block(f, b);
    return spec_peak_bin(b);
}
var turbo_bin = fi_peak_bin(GH_INDUCTION_TURBO);
var sc_bin = fi_peak_bin(GH_INDUCTION_SUPERCHARGER);
assert_gt(turbo_bin, 0, "turbo has a real peak (not a vacuous compare)");
assert_gt(sc_bin, 0, "supercharger has a real peak");
assert_gt(turbo_bin, sc_bin, "turbo whines HIGHER than a supercharger");
# The ratio must be the blade:lobe ratio, 10/3 = 3.33, not merely "different".
var fi_ratio = f64_div(f64_from(turbo_bin), f64_from(sc_bin));
assert_gt(fi_ratio, f64_from(3), "turbo/supercharger ratio is about 10/3");
assert_lt(fi_ratio, f64_from(4), "turbo/supercharger ratio is about 10/3");

# ================================================================
test_group("load tilts the SPECTRUM, not just the level (ADR-007)");
# Until 2.3.0 load was a pure GAIN control. Measured: the motor's spectral
# centroid was 2061.2 Hz at load 0.1, 0.5 AND 0.9 -- identical to four figures --
# while RMS nearly doubled. The engine was worse than flat: its centroid FELL as
# load rose, because base_amp scaled the low-frequency combustion thump too.
fn spec_centroid(v) {
    var m = fft_magnitudes(v);
    var n = vec_len(m);
    var num = 0;
    var den = 0;
    var i = 1;
    while (i < n) {
        var mg = vec_get(m, i);
        var f = f64_div(f64_mul(f64_from(i), SR), f64_from(SPEC_N));
        num = f64_add(num, f64_mul(f, mg));
        den = f64_add(den, mg);
        i = i + 1;
    }
    if (f64_le(den, 0) == 1) { return 0; }
    return f64_div(num, den);
}
fn motor_centroid_at(load) {
    var m = ghurni_motor_new(GH_MOTOR_BRUSHLESS, 8, SR);
    ghurni_motor_set_rpm(m, f64_from(3000));
    ghurni_motor_set_load(m, load);
    var w = spec_block();
    ghurni_motor_process_block(m, w);
    var b = spec_block();
    ghurni_motor_process_block(m, b);
    return spec_centroid(b);
}
var mc_lo = motor_centroid_at(0.1);
var mc_mid = motor_centroid_at(0.5);
var mc_hi = motor_centroid_at(0.9);
assert_gt(mc_lo, f64_from(500), "motor centroid is a real measurement (not a vacuous 0)");
assert_lt(mc_lo, mc_mid, "motor: more load is BRIGHTER (0.1 -> 0.5)");
assert_lt(mc_mid, mc_hi, "motor: more load is BRIGHTER (0.5 -> 0.9)");

fn engine_centroid_at(load) {
    var e = ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR);
    ghurni_engine_set_rpm(e, f64_from(3000));
    ghurni_engine_set_load(e, load);
    var w = spec_block();
    ghurni_engine_process_block(e, w);
    var b = spec_block();
    ghurni_engine_process_block(e, b);
    return spec_centroid(b);
}
var ec_lo = engine_centroid_at(0.1);
var ec_hi = engine_centroid_at(0.9);
assert_gt(ec_lo, f64_from(500), "engine centroid is a real measurement");
assert_lt(ec_lo, ec_hi, "engine: more load is BRIGHTER, not duller");

# The tilt is exactly 1.0 at zero load, so an unloaded machine is untouched.
assert_eq(ghurni_load_tilt(0), F64_ONE, "tilt(0) = 1.0 exactly -- unloaded audio is unchanged");
assert_gt(ghurni_load_tilt(F64_ONE), F64_ONE, "tilt rises with load");
assert_eq(ghurni_load_tilt(f64_div(0, 0)), F64_ONE, "NaN load -> tilt 1.0, never propagates");
assert_eq(ghurni_load_tilt_k(0, f64_from(3)), F64_ONE, "tilt_k(0, k) = 1.0 for any k");

# ================================================================
test_group("diesel has injection clatter; gasoline does not (ADR-007)");
# Until 2.3.0 Diesel differed from Gasoline in exactly THREE numbers (exhaust
# resonance, intake resonance, roughness base) -- a retuned petrol engine. The
# signature diesel rattle comes from the near-instant pressure rise after
# injection delay, and it puts energy high in the spectrum.
fn eng_centroid(ty) {
    var e = ghurni_engine_new(ty, 6, SR);
    ghurni_engine_set_rpm(e, f64_from(2000));
    ghurni_engine_set_load(e, 0.8);
    var w = spec_block();
    ghurni_engine_process_block(e, w);
    var b = spec_block();
    ghurni_engine_process_block(e, b);
    return spec_centroid(b);
}
var c_diesel = eng_centroid(GH_ENGINE_DIESEL);
var c_petrol = eng_centroid(GH_ENGINE_GASOLINE);
assert_gt(c_petrol, f64_from(500), "gasoline centroid is a real measurement");
assert_gt(c_diesel, c_petrol, "diesel is BRIGHTER than gasoline at the same rpm and load");
# ...and by a margin that a mere resonance retune could not produce.
assert_gt(f64_div(c_diesel, c_petrol), 1.05, "the diesel margin is substantial, not incidental");

var rc = assert_summary();
syscall(60, rc);
