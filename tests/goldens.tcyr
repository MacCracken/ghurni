test_group("golden: rotating");
golden(ghurni_gear_synthesize(ghurni_gear_new(32, GH_GEAR_STEEL, SR), f64_from(1500), 0.1),
  4410, 0 - 7414103304742362022, "steel gear 32t @1500");
golden(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_BRUSHLESS, 8, SR), f64_from(4000), 0.5, 0.1),
  4410, 0 - 7925099783061075357, "brushless motor 8p @4000");
golden(ghurni_turbine_synthesize(ghurni_turbine_new(12, f64_from(600), SR), f64_from(8000), 0.1),
  4410, 1523957458651737894, "ducted turbine 12b @8000");
# 3 s, not 0.5 s: a grandfather clock beats at 1 Hz, so the old half-second
# window contained only beat 0 and never covered a TOCK at all. The tick/tock
# asymmetry added in 2.2.0 was therefore invisible to this golden -- it did not
# move when the behaviour changed, which is exactly the blind spot a golden
# suite must not have.
golden(ghurni_clock_synthesize(ghurni_clock_new(GH_CLOCK_GRANDFATHER_CLOCK, SR), f64_from(3)),
  132300, 0 - 5573599848128827731, "grandfather clock 3 s (tick AND tock)");

