golden(ghurni_forced_induction_synthesize(ghurni_forced_induction_new(GH_INDUCTION_SUPERCHARGER, f64_from(2), 0.3, SR),
    f64_from(5000), 0.8, 0.1),
  4410, 0 - 5187097507001423249, "supercharger");
