var gml = g_zeros(4410);
var gmr = g_zeros(4410);
ghurni_mixer_process_block_stereo(gm, gml, gmr);
golden(gml, 4410, 2618789759692434452, "mixer left, through the pan law");
golden(gmr, 4410, 3444679867906830671, "mixer right, through the pan law");

# ================================================================
test_group("golden: phase continuity (2.8.0)");
# Recorded from the 2.8.0 render. Every golden above starts a synth from rest and
# holds one speed, which is exactly the case 2.7.2 already got right; these pin the
# paths ADR-012 changed: speed changes mid-stream, set clock rates, the hybrid's
# STARTUP, the reverse gear, and rates low enough to have broken a constructor.
# g_stream(kind, synth, warm) -- `warm` 441-sample blocks at 1500 rpm, then a ramp
# to 4350 in 20 blocks, the ramp returned.
fn g_stream(kind, syn, warm) {
    ghurni_synth_set_rpm(kind, syn, f64_from(1500));
    var w = 0;
    while (w < warm) { ghurni_synth_process_block(kind, syn, g_zeros(441)); w = w + 1; }
    var o = vec_new();
    var k = 0;
    while (k < 20) {
        ghurni_synth_set_rpm(kind, syn, f64_from(1500 + k * 150));
        var b = g_zeros(441);
        ghurni_synth_process_block(kind, syn, b);
        var j = 0;
        while (j < 441) { vec_push(o, vec_get(b, j)); j = j + 1; }
        k = k + 1;
    }
    return o;
}
golden(g_stream(GH_KIND_ENGINE, ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR), 100), 8820,
  641913399473827267, "engine ramp, 1 s in");
golden(g_stream(GH_KIND_GEAR, ghurni_gear_new(32, GH_GEAR_STEEL, SR), 100), 8820,
  6278952186483980299, "gear ramp, 1 s in");
golden(g_stream(GH_KIND_DIFFERENTIAL, ghurni_differential_new(41, 11, SR), 100), 8820,
  5722252706194028994, "differential ramp, 1 s in");
golden(g_stream(GH_KIND_CHAIN_DRIVE, ghurni_chain_drive_new(110, 16, SR), 100), 8820,
  0 - 9042680913790882840, "chain ramp, 1 s in");
golden(g_stream(GH_KIND_BELT_DRIVE, ghurni_belt_drive_new(f64_from(120), 0.6, SR), 100), 8820,
  1301572221310081712, "belt ramp, 1 s in");
golden(g_stream(GH_KIND_TRANSMISSION, ghurni_transmission_new(g_ratios, 24, SR), 100), 8820,
  0 - 4268033683276706704, "transmission ramp, 1 s in");
var gc = ghurni_clock_new(GH_CLOCK_WALL_CLOCK, SR);
ghurni_clock_set_tick_rate(gc, 0.5);
golden(ghurni_clock_synthesize(gc, f64_from(3)), 132300, 6918240146402963787, "wall clock at 0.5 Hz");
var gcr = ghurni_clock_new(GH_CLOCK_POCKET_WATCH, SR);
var gcro = vec_new();
var gk = 0;
while (gk < 30) {
    ghurni_clock_set_tick_rate(gcr, f64_add(f64_from(5), f64_from(gk % 9)));
    var gb = g_zeros(1470);
    ghurni_clock_process_block(gcr, gb);
    var gj = 0;
    while (gj < 1470) { vec_push(gcro, vec_get(gb, gj)); gj = gj + 1; }
    gk = gk + 1;
}
golden(gcro, 44100, 0 - 5728127904848644562, "pocket watch, rate changed every block");
var gh = ghurni_engine_new(GH_ENGINE_HYBRID, 4, SR);
ghurni_engine_set_rpm(gh, f64_from(3000));
ghurni_engine_set_load(gh, 0.6);
ghurni_engine_process_block(gh, g_zeros(2048));
ghurni_engine_trigger_event(gh, ghurni_event_new(GH_EVENT_STARTUP, 0, 0));
var gho = g_zeros(4410);
ghurni_engine_process_block(gh, gho);
golden(gho, 4410, 2397232189754668555, "hybrid STARTUP: whine and starter apart");
var grv = vec_new();
vec_push(grv, 3.5); vec_push(grv, f64_neg(3.2));
var grt = ghurni_transmission_new(grv, 24, SR);
ghurni_transmission_shift_to(grt, 1);
golden(ghurni_transmission_synthesize(grt, f64_from(3000), 0.1), 4410, 4656547065775572622, "reverse gear");
var LSR = f64_from(8000);
golden(ghurni_transmission_synthesize(ghurni_transmission_new(g_ratios, 24, LSR), f64_from(3000), 0.1),
  800, 0 - 8055341237765367979, "transmission at 8 kHz (its constructor failed until 2.8.0)");
golden(ghurni_gear_synthesize(ghurni_gear_new(32, GH_GEAR_STEEL, f64_from(400)), f64_from(30), 0.5),
  200, 0 - 3588820725339905473, "gear at 400 Hz keeps its third partial");

# ================================================================
test_group("golden: the checksum itself is sensitive");
# A golden suite whose hash cannot tell two buffers apart is worse than none.
# These prove the function reacts to magnitude, to ORDER, and to length.
var probe_a = vec_new();
var probe_b = vec_new();
var pi = 0;
while (pi < 64) { vec_push(probe_a, f64_from(pi)); vec_push(probe_b, f64_from(pi)); pi = pi + 1; }
assert_eq(golden_ck(probe_a), golden_ck(probe_b), "identical buffers hash identically");
vec_set(probe_b, 30, f64_add(vec_get(probe_b, 30), 0.001));
assert_neq(golden_ck(probe_a), golden_ck(probe_b), "a 0.001 change in ONE sample changes the hash");
# Order sensitivity: swap two samples, same multiset, different hash.
var probe_c = vec_new();
var ci = 0;
while (ci < 64) { vec_push(probe_c, f64_from(ci)); ci = ci + 1; }
var tmp = vec_get(probe_c, 5);
vec_set(probe_c, 5, vec_get(probe_c, 6));
vec_set(probe_c, 6, tmp);
assert_neq(golden_ck(probe_a), golden_ck(probe_c), "swapping two samples changes the hash");
# Quantization floor: a change far below 1e-6 is deliberately invisible, which
# is what makes these portable across libm implementations.
var probe_d = vec_new();
var di = 0;
while (di < 64) { vec_push(probe_d, f64_from(di)); di = di + 1; }
vec_set(probe_d, 12, f64_add(vec_get(probe_d, 12), 0.000000001));
assert_eq(golden_ck(probe_a), golden_ck(probe_d), "a 1e-9 change is below the quantization floor");

var rc = assert_summary();
syscall(60, rc);
