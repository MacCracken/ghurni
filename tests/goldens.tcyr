test_group("golden: control paths (2.7.2)");
# Values recorded from the 2.7.1 render. Goldens used to cover only default
# configurations, so 55 of 176 decimal literals could be doubled with the suite
# green: every event level, every load and shift term. Events and load are the
# paths a phase-integration change (2.8.0) will touch first, so they are pinned now.
fn g_zeros(n) { var v = vec_new(); var i = 0; while (i < n) { vec_push(v, 0); i = i + 1; } return v; }
# g_event(kind, a0) -- one block of a 4-cylinder engine just after the event.
fn g_event(kind, a0) {
    var e = ghurni_engine_new(GH_ENGINE_GASOLINE, 4, SR);
    ghurni_engine_set_rpm(e, f64_from(3000));
    ghurni_engine_set_load(e, 0.6);
    ghurni_engine_process_block(e, g_zeros(2048));
    ghurni_engine_trigger_event(e, ghurni_event_new(kind, a0, 0));
    var o = g_zeros(4410);
    ghurni_engine_process_block(e, o);
    return o;
}
golden(ghurni_engine_synthesize(ghurni_engine_new(GH_ENGINE_TWO_STROKE, 2, SR), f64_from(5000), 0.7, 0.1),
  4410, 3556476551196008577, "two-stroke 2cyl @5000 load 0.7");
golden(g_event(GH_EVENT_BACKFIRE, 1), 4410, 0 - 83110229534283581, "engine event BACKFIRE");
golden(g_event(GH_EVENT_MISFIRE, 1), 4410, 8513938396095100439, "engine event MISFIRE");
golden(g_event(GH_EVENT_KNOCK, 1), 4410, 7687632697723357446, "engine event KNOCK");
golden(g_event(GH_EVENT_STALL, 1), 4410, 0 - 9085029235230921190, "engine event STALL");
golden(g_event(GH_EVENT_REV_LIMITER_HIT, 1), 4410, 0 - 2268607160724810337, "engine event REV_LIMITER_HIT");
golden(g_event(GH_EVENT_STARTUP, 1), 4410, 0 - 5553513719329589983, "engine event STARTUP");
golden(g_event(GH_EVENT_SHUTDOWN, 1), 4410, 0 - 8354362766099458070, "engine event SHUTDOWN");
var gg = ghurni_gear_new(32, GH_GEAR_STEEL, SR);
ghurni_gear_set_load(gg, 0.7);
golden(ghurni_gear_synthesize(gg, f64_from(1500), 0.1), 4410, 1377788477134072868, "gear under load");
golden(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_DC_BRUSHED, 8, SR), f64_from(4000), 0.5, 0.1),
  4410, 0 - 4199621990139548193, "brushed motor");
golden(ghurni_motor_synthesize(ghurni_motor_new(GH_MOTOR_AC_INDUCTION, 8, SR), f64_from(4000), 0.5, 0.1),
  4410, 1625132178302510588, "induction motor");
golden(
  ghurni_clock_synthesize(ghurni_clock_new(GH_CLOCK_WRISTWATCH, SR), F64_ONE),
  44100,
  994560110193977063,
  "wristwatch");
golden(
  ghurni_clock_synthesize(ghurni_clock_new(GH_CLOCK_WALL_CLOCK, SR), F64_ONE),
  44100,
  0 - 8271398183188355428,
  "wall clock");
golden(
  ghurni_clock_synthesize(ghurni_clock_new(GH_CLOCK_POCKET_WATCH, SR), F64_ONE),
  44100,
  0 - 3731309146167166317,
  "pocket watch");
var gt = ghurni_transmission_new(g_ratios, 24, SR);
ghurni_transmission_set_rpm(gt, f64_from(3000));
ghurni_transmission_set_load(gt, 0.7);
