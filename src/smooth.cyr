# smooth.cyr -- one-pole exponential parameter smoother.
# Ports rust-old/src/smooth.rs (SmoothedParam). Prevents clicks when RPM / load
# change mid-block by exponentially approaching the target. Was a `pub` type.
#
# Requires (from the build/test unit): error.cyr (ghurni_is_finite, GhJson_*) +
# stdlib alloc + math (F64_ONE, f64_* builtins). The module file has no `include`
# lines.
#
# serde: SmoothedParam was Serialize/Deserialize. Hand-written since 2.7.2 (the
# derived scanner overran an unterminated key); f64 fields travel as exact bit
# patterns. See the strict reader in error.cyr.

# is_settled tolerance: 1e-6 (Rust used the literal 1e-6, not f32::EPSILON).
var GHURNI_SMOOTH_SETTLE = 0.000001;   # 1e-6

# ================================================================
# GhSmoothedParam
#   current : current smoothed value
#   target  : target value (approached smoothly)
#   coeff   : one-pole coefficient exp(-1/(smooth_time_s*sample_rate)), or 0
# ================================================================
#derive(accessors)
struct GhSmoothedParam {
    current: i64;
    target: i64;
    coeff: i64;
}

# new(initial, smooth_time_s, sample_rate). coeff = exp(-1/(t*sr)) when both
# t>0 and sr>0, else 0 (snaps instantly).
#
# `smooth_time_s` is a TIME CONSTANT (tau), NOT a settling time. The oracle
# documents it as "Time constant in seconds (63% of the way to target)"
# (rust-old/src/smooth.rs:20). After exactly t*sr samples the value has covered
# 1 - 1/e = 63.2% of the distance and is still moving -- it never arrives
# exactly. So the call-site values (0.02 / 0.03 / 0.05 s, and forced_induction's
# spool_inertia) are tau, and a caller wanting "settled in 50 ms" wants a
# considerably smaller number. tests/oracle_pins.tcyr pins the 63% behaviour.
#must_use
fn ghurni_smooth_new(initial, smooth_time_s, sample_rate) {
    var p = alloc(sizeof(GhSmoothedParam));
    var coeff = 0;
    if ((f64_gt(smooth_time_s, 0) == 1) && (f64_gt(sample_rate, 0) == 1)) {
        coeff = f64_exp(f64_neg(f64_div(F64_ONE, f64_mul(smooth_time_s, sample_rate))));
    }
    # A non-finite start could never leave `current`: it is a feedback value.
    var start = initial;
    if (ghurni_is_finite(start) == 0) { start = 0; }
    GhSmoothedParam_set_current(p, start);
    GhSmoothedParam_set_target(p, start);
    GhSmoothedParam_set_coeff(p, coeff);
    return p;
}

# set_target(v) -- set the value to smoothly approach. A non-finite target is
# ignored, as the mixer and synth setters ignore an out-of-range value.
fn ghurni_smooth_set_target(p, target) {
    if (ghurni_is_finite(target) == 0) { return 0; }
    GhSmoothedParam_set_target(p, target);
    return 0;
}

# next_value() -- advance one sample: current = target + coeff*(current-target).
#
# Two guards on the result, which feeds back (2.7.2). A finite step can overflow
# (+f64::MAX toward -f64::MAX), and Inf then stays forever, so a non-finite result
# lands on the target. A smoother heading to 0 is a pure geometric decay that sticks
# in subnormals and never arrives, so those flush. Exact zeros keep their sign.
fn ghurni_smooth_next_value(p) {
    var target = GhSmoothedParam_target(p);
    var cur = f64_add(target, f64_mul(GhSmoothedParam_coeff(p), f64_sub(GhSmoothedParam_current(p), target)));
    var e = cur & GHURNI_F64_EXP_MASK;
    if (e == GHURNI_F64_EXP_MASK) { cur = target; }
    elif ((e == 0) && ((cur & GHURNI_F64_ABS_MASK) != 0)) { cur = 0; }
    GhSmoothedParam_set_current(p, cur);
    return cur;
}

# snap() -- jump instantly to target (no smoothing).
fn ghurni_smooth_snap(p) {
    GhSmoothedParam_set_current(p, GhSmoothedParam_target(p));
    return 0;
}

# current() -- read the current smoothed value without advancing.
#must_use
fn ghurni_smooth_current(p) {
    return GhSmoothedParam_current(p);
}

# target() -- read the target value.
#must_use
fn ghurni_smooth_target(p) {
    return GhSmoothedParam_target(p);
}

# is_settled() -- 1 iff |current - target| < 1e-6.
#must_use
fn ghurni_smooth_is_settled(p) {
    var d = f64_abs(f64_sub(GhSmoothedParam_current(p), GhSmoothedParam_target(p)));
    return f64_lt(d, GHURNI_SMOOTH_SETTLE);
}

# Serde. Fields travel as exact f64 bit patterns in decimal. Refuses a non-finite
# value, and a coeff outside [0, 1], which would be unstable.
# to_json(ptr, sb) -> 0 or GH_ERR_*.
fn GhSmoothedParam_to_json(ptr, sb) {
    if ((ptr < GHURNI_MIN_VALID_PTR) || (sb < GHURNI_MIN_VALID_PTR)) { return GH_ERR_INVALID_PARAMETER; }
    return GhJson_write3(
        sb,
        "current",
        GhSmoothedParam_current(ptr),
        "target",
        GhSmoothedParam_target(ptr),
        "coeff",
        GhSmoothedParam_coeff(ptr));
}

# Build a smoother from three read fields, or GH_ERR_INVALID_PARAMETER.
fn GhSmoothedParam_from_vals(vals) {
    var cur = load64(vals);
    var tgt = load64(vals + 8);
    var coeff = load64(vals + 16);
    if ((ghurni_is_finite(cur) == 0) || (ghurni_is_finite(tgt) == 0)) { return GH_ERR_INVALID_PARAMETER; }
    if ((f64_ge(coeff, 0) == 0) || (f64_le(coeff, F64_ONE) == 0)) { return GH_ERR_INVALID_PARAMETER; }
    var p = alloc(sizeof(GhSmoothedParam));
    GhSmoothedParam_set_current(p, cur);
    GhSmoothedParam_set_target(p, tgt);
    GhSmoothedParam_set_coeff(p, coeff);
    return p;
}

# from_json_str(json) -> ptr or GH_ERR_INVALID_PARAMETER.
#must_use
fn GhSmoothedParam_from_json_str(json) {
    var vals[24];
    if (GhJson_read3(json, "current", "target", "coeff", &vals) == 0) { return GH_ERR_INVALID_PARAMETER; }
    return GhSmoothedParam_from_vals(&vals);
}

# from_json(pairs) -> ptr or GH_ERR_INVALID_PARAMETER.
#must_use
fn GhSmoothedParam_from_json(pairs) {
    var vals[24];
    if (GhJson_pairs3(pairs, "current", "target", "coeff", &vals) == 0) { return GH_ERR_INVALID_PARAMETER; }
    return GhSmoothedParam_from_vals(&vals);
}
